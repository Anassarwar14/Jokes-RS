# Copy this file to .env and adjust settings for your environment

# Database
DATABASE_URL=postgresql://jokes_user:jokes_password@localhost:5433/jokes_db

# API Settings
API_TITLE="Jokes Recommendation API"
API_VERSION="1.0.0"
DEBUG=True

# CORS origins (comma-separated)
CORS_ORIGINS=["*"]

# Model Configuration
DEFAULT_MODEL=pmf
DEFAULT_SEED=42

# Paths (relative to project root)
MODELS_DIR=./models
PROCESSED_DATA_DIR=./data/processed
